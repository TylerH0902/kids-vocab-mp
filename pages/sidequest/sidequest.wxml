<view class="page">

  <!-- Map background -->
  <image class="map-bg" src="{{bgImage}}" mode="aspectFill" />

  <!-- HUD overlay -->
  <view class="hud">
    <view class="hud-top">
      <button class="btn-back" bindtap="goBack">{{backLabel}}</button>
      <view class="lang-row">
        <view class="lang-btn {{lang==='en'?'active':''}}" bindtap="setLang" data-val="en">EN</view>
        <view class="lang-btn {{lang==='zh'?'active':''}}" bindtap="setLang" data-val="zh">中</view>
      </view>
    </view>
    <view class="balance-bar">
      <text class="balance-text">⭐ {{balance}} pts</text>
      <view class="btn-ach" bindtap="goAchievements">🏆</view>
    </view>
  </view>

  <!-- Map locations -->
  <view
    wx:for="{{locations}}"
    wx:key="id"
    class="loc-wrap"
    style="left:{{item.left}}%;top:{{item.top}}%;"
    bindtap="onLocTap"
    data-id="{{item.id}}"
  >
    <view class="loc-ring {{item.unlocked ? (item.stars>0 ? 'ring-done' : 'ring-open') : 'ring-locked'}}">
      <text wx:if="{{!item.unlocked}}" class="loc-lock">🔒</text>
      <view wx:elif="{{item.stars > 0}}" class="loc-stars-row">
        <text class="loc-star {{item.stars>=1?'lit':''}}">★</text>
        <text class="loc-star {{item.stars>=2?'lit':''}}">★</text>
        <text class="loc-star {{item.stars>=3?'lit':''}}">★</text>
      </view>
      <view wx:else class="loc-pulse" />
    </view>
  </view>

  <!-- Popup mask -->
  <view wx:if="{{popup}}" class="mask" bindtap="closePopup" />

  <!-- Book popup (bottom sheet) -->
  <view wx:if="{{popup}}" class="popup popup-show">
    <view class="popup-handle" />
    <text class="popup-title">{{popup.title}}</text>
    <text class="popup-sub">{{popup.sub}}</text>
    <view class="popup-stars" wx:if="{{popup.played}}">
      <text class="p-star {{popup.stars>=1?'lit':''}}">★</text>
      <text class="p-star {{popup.stars>=2?'lit':''}}">★</text>
      <text class="p-star {{popup.stars>=3?'lit':''}}">★</text>
      <text class="p-best">{{popup.bestText}}</text>
    </view>
    <button wx:if="{{popup.unlocked}}" class="popup-btn" bindtap="onPlay">
      {{lang==='en' ? (popup.played ? 'Play Again 🚀' : 'Start Quest 🚀') : (popup.played ? '再玩一次 🚀' : '开始冒险 🚀')}}
    </button>
    <view wx:else class="unlock-row">
      <text class="unlock-cost">🔒 {{popup.cost}} pts to unlock</text>
      <button class="popup-btn {{popup.canAfford ? '' : 'dim'}}" bindtap="onUnlock">
        {{popup.canAfford ? (lang==='en'?'Unlock':'解锁') : (lang==='en'?'Not enough pts':'积分不足')}}
      </button>
    </view>
  </view>

</view>
