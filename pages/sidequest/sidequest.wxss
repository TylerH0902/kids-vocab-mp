.page {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  overflow: hidden;
}

.map-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 0;
}

/* ── HUD ──────────────────────────────────────────────────── */
.hud {
  position: absolute;
  top: 0; left: 0; right: 0;
  z-index: 10;
  padding: 48rpx 28rpx 0;
  display: flex; flex-direction: column; gap: 12rpx;
}
.hud-top {
  display: flex; justify-content: space-between; align-items: center;
}
.btn-back {
  background: rgba(0,0,0,.45); color: #fff;
  font-size: 26rpx; font-weight: 700;
  border-radius: 40rpx; padding: 10rpx 28rpx;
  border: 1rpx solid rgba(255,255,255,.3);
  line-height: 1.4;
}
.lang-row { display: flex; gap: 10rpx; }
.lang-btn {
  padding: 8rpx 18rpx; border-radius: 30rpx;
  border: 2rpx solid rgba(255,255,255,.5);
  color: rgba(255,255,255,.7);
  font-size: 22rpx; font-weight: 700;
  background: rgba(0,0,0,.3);
}
.lang-btn.active { background: rgba(255,255,255,.9); color: #333; border-color: #fff; }

.balance-bar {
  display: flex; justify-content: space-between; align-items: center;
  background: rgba(0,0,0,.4);
  border-radius: 14rpx; padding: 12rpx 20rpx;
}
.balance-text { font-size: 26rpx; font-weight: 800; color: #FFD700; }
.btn-ach { font-size: 32rpx; }

/* ── Map locations ────────────────────────────────────────── */
.loc-wrap {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 5;
}

.loc-ring {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  border: 4rpx solid rgba(255,255,255,.9);
}
.ring-open {
  background: rgba(255,255,255,.25);
  border-color: #fff;
  animation: pulse 1.8s ease-in-out infinite;
}
.ring-done  { background: rgba(255,215,0,.3); border-color: #FFD700; }
.ring-locked { background: rgba(0,0,0,.4); border-color: rgba(255,255,255,.3); }

@keyframes pulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(255,255,255,.55); }
  50%      { box-shadow: 0 0 0 16rpx rgba(255,255,255,.0); }
}

.loc-pulse {
  width: 28rpx; height: 28rpx; border-radius: 50%;
  background: rgba(255,255,255,.9);
}
.loc-lock { font-size: 32rpx; }

.loc-stars-row { display: flex; gap: 2rpx; }
.loc-star { font-size: 22rpx; color: rgba(255,255,255,.3); }
.loc-star.lit { color: #FFD700; }

/* ── Popup (bottom sheet) ─────────────────────────────────── */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.4);
  z-index: 20;
}

.popup {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 40rpx 60rpx;
  z-index: 30;
  display: flex; flex-direction: column; align-items: center; gap: 20rpx;
  transform: translateY(100%);
  transition: transform .28s cubic-bezier(.32,1,.28,1);
}
.popup-show { transform: translateY(0); }

.popup-handle {
  width: 80rpx; height: 8rpx; border-radius: 8rpx;
  background: #ddd; margin-bottom: 8rpx;
}
.popup-title {
  font-size: 40rpx; font-weight: 900; color: #1a1a2e;
  text-align: center;
}
.popup-sub { font-size: 26rpx; color: #666; text-align: center; }

.popup-stars {
  display: flex; align-items: center; gap: 8rpx;
}
.p-star { font-size: 40rpx; color: #ddd; }
.p-star.lit { color: #FFD700; }
.p-best { font-size: 24rpx; color: #999; margin-left: 8rpx; }

.popup-btn {
  width: 100%; border-radius: 60rpx;
  background: linear-gradient(135deg, #ff9a3c, #ff6b35);
  color: #fff; font-size: 34rpx; font-weight: 900;
  padding: 24rpx 0; text-align: center;
  border: none;
}
.popup-btn.dim {
  background: #ccc; color: #999;
}

.unlock-row {
  width: 100%; display: flex; flex-direction: column; gap: 16rpx; align-items: center;
}
.unlock-cost { font-size: 28rpx; color: #888; font-weight: 700; }
